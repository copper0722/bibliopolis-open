# dependencies and builds
node_modules/
dist/
build/
.out/
.vite/
coverage/
*.egg-info/
*.log
__pycache__/
*.pyc
.venv/

# local runtime, data and secrets
var/
.env
.env.*
*.local
.DS_Store

# a derived city is rebuilt from its library, never committed
/city.json
/city-*.json

# binary payload never enters Git
*.png
*.jpg
*.jpeg
*.webp
*.avif
*.glb
*.bin
*.blend
*.pdf

# ... except the pictures of the README: images in docs/images/ only (under 1 MB each)
!docs/images/*.png
!docs/images/*.jpg
!docs/images/*.webp
