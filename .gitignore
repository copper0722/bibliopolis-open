# dependencies and builds
node_modules/
dist/
build/
.out/
.vite/
coverage/
*.egg-info/
*.log
__pycache__/
*.pyc
.venv/

# local runtime, data and secrets
var/
.env
.env.*
*.local
.DS_Store

# a derived city and its picture are rebuilt from the library, never committed
/city.json
/city-*.json
/city.svg
/city-*.svg

# binary payload never enters Git
*.png
*.jpg
*.jpeg
*.webp
*.avif
*.glb
*.bin
*.blend
*.pdf

# ... except PNG images directly under docs/images/ (at most 1 MiB each, pixels only)
!docs/images/*.png
